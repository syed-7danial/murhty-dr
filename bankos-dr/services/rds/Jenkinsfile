pipeline {
    agent any
    
    parameters {
        choice(name: 'SWITCHING_TO', choices: ['ACTIVE', 'FAILOVER'], description: 'Select the environment')
        choice(name: 'CLIENT_NAME', choices: ['None', 'All', 'ach', 'fedwire', 'fednow', 'rtp', 'sample-client', 'udr'], description: 'Select the CLIENT_NAME')
        text(name: 'CUSTOM_CLIENTS', defaultValue: '', description: 'If provided, only these comma-separated clients will be processed (e.g., ach,fedwire,fednow)')
        string(name: 'BATCH_SIZE', defaultValue: '5', description: 'Number of RDS resources to process in parallel')
        password(name: 'AWS_ACCESS_KEY_ID', defaultValue: '', description: 'AWS_ACCESS_KEY_ID')
        password(name: 'AWS_SECRET_ACCESS_KEY', defaultValue: '', description: 'AWS_SECRET_ACCESS_KEY')
        password(name: 'AWS_SESSION_TOKEN', defaultValue: '', description: 'AWS_SESSION_TOKEN')
        booleanParam(name: 'PROCESS_CURRENT_ENV', defaultValue: false, description: 'Check this to process current environment')
        booleanParam(name: 'PROCESS_COMMON_CONFIG', defaultValue: false, description: 'Process common configuration')
    }
    
    stages {
        stage('Install Node.js Packages') {
            steps {
                sh '''
                cd bankos-dr
                npm install
                '''
            }
        }

        stage('Determine Clients to Process') {
            steps {
                script {
                    env.AWS_ACCESS_KEY_ID = params.AWS_ACCESS_KEY_ID
                    env.AWS_SECRET_ACCESS_KEY = params.AWS_SECRET_ACCESS_KEY
                    env.AWS_SESSION_TOKEN = params.AWS_SESSION_TOKEN
                    env.SWITCHING_TO = params.SWITCHING_TO

                    def clientsToProcess = []
                    if (params.CUSTOM_CLIENTS?.trim()) {
                        clientsToProcess = params.CUSTOM_CLIENTS.split(',').collect { it.trim() }
                    } 
                    else if (params.CLIENT_NAME == 'All') {
                        clientsToProcess = ['ach', 'fedwire', 'fednow', 'rtp', 'sample-client', 'udr']
                    }
                    else if (params.CLIENT_NAME != 'None') {
                        clientsToProcess = [params.CLIENT_NAME]
                    }
                    
                    if (params.PROCESS_COMMON_CONFIG) {
                        clientsToProcess.add('common')
                    }
                    
                    if (clientsToProcess.isEmpty()) {
                        echo "No clients selected. Please select a CLIENT_NAME, provide CUSTOM_CLIENTS, or enable PROCESS_COMMON_CONFIG."
                        env.SKIP_PROCESSING = 'true'
                        return
                    }
                    
                    env.CLIENTS_TO_PROCESS = clientsToProcess.join(',')
                    echo "Clients to process: ${env.CLIENTS_TO_PROCESS}"
                    env.SKIP_PROCESSING = 'false'
                }
            }
        }

        stage('Process Clients') {
            when {
                expression { return env.SKIP_PROCESSING != 'true' }
            }
            steps {
                script {
                    def clientsList = env.CLIENTS_TO_PROCESS.split(',')
                    def parallelStages = [:]

                    writeFile file: 'rds_resources_chunk.js', text: '''
                    const fs = require('fs');
                    const path = require('path');
                    
                    const client = process.argv[2];
                    
                    try {
                        const configPath = path.join(process.cwd(), 'bankos-dr', 'configuration', client, 'rds', 'configuration.json');
                        if (fs.existsSync(configPath)) {
                            const config = JSON.parse(fs.readFileSync(configPath, 'utf8'));
                            
                            if (config.rds && Array.isArray(config.rds)) {
                                console.log(config.rds.length);
                            } else {
                                console.log(0);
                            }
                        } else {
                            console.log(0);
                        }
                    } catch (error) {
                        console.error(`Error processing config for ${client}:`, error);
                        console.log(0);
                    }
                    '''
                    
                    // Create parallel stages for each client
                    for (def client in clientsList) {
                        def currentClient = client
                        
                        parallelStages["Client: ${currentClient}"] = {
                            stage("Process Client: ${currentClient}") {
                                def rdsCount = sh(script: "node rds_resources_chunk.js ${currentClient}", returnStdout: true).trim().toInteger()
                                
                                if (rdsCount > 0) {
                                    echo "Found ${rdsCount} RDS resources for client ${currentClient}"
                                    
                                    def batchSize = params.BATCH_SIZE.toInteger()
                                    def batchCount = Math.ceil(rdsCount / batchSize)
                                    
                                    // Process all batches
                                    for (int batchIndex = 0; batchIndex < batchCount; batchIndex++) {
                                        def startIndex = batchIndex * batchSize
                                        def endIndex = Math.min((batchIndex + 1) * batchSize - 1, rdsCount - 1)
                                        
                                        echo "Processing batch ${batchIndex + 1}/${batchCount} (resources ${startIndex}-${endIndex}) for client ${currentClient}"
                                        
                                        // Create parallel tasks for this batch
                                        def parallelTasks = [:]
                                        
                                        for (int i = startIndex; i <= endIndex; i++) {
                                            def rdsIndex = i
                                            
                                            parallelTasks["RDS Resource ${rdsIndex+1}"] = {
                                                def command = "node bankos-dr/services/rds/main.js"
                                                withEnv([
                                                    "CLIENT_NAME=${currentClient}",
                                                    "RDS_INDEX=${rdsIndex}"
                                                ]) {
                                                    if (params.PROCESS_CURRENT_ENV) {
                                                        command += ' -pce'
                                                    }
                                                    
                                                    command += " --rds-index=${rdsIndex}"
                                                    
                                                    echo "Processing RDS resource index ${rdsIndex} for client: ${currentClient}"
                                                    sh command
                                                }
                                            }
                                        }
                                        
                                        // Execute the parallel tasks for this batch
                                        parallel parallelTasks
                                    }
                                } else {
                                    echo "No RDS resources found for client ${currentClient}"
                                }
                            }
                        }
                    }
                    
                    // Execute all client stages in parallel
                    parallel parallelStages
                }
            }
        }
    }

    post {
        always {
            cleanWs()  // Clean up workspace after the pipeline execution
        }
    }
}