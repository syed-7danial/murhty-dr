pipeline {
    agent any
    parameters {
        choice(name: 'SWITCHING_TO', choices: ['ACTIVE', 'FAILOVER'], description: 'Select the environment')
        choice(name: 'CLIENT_NAME', choices: ['All', 'ach', 'fedwire', 'fednow', 'rtp', 'sample-client', 'udr'], description: 'Select the CLIENT_NAME')
        text(name: 'CUSTOM_CLIENTS', defaultValue: '', description: 'If provided, only these comma-separated clients will be processed (e.g., ach,fedwire,fednow)')
        password(name: 'AWS_ACCESS_KEY_ID', defaultValue: '', description: 'AWS_ACCESS_KEY_ID')
        password(name: 'AWS_SECRET_ACCESS_KEY', defaultValue: '', description: 'AWS_SECRET_ACCESS_KEY')
        password(name: 'AWS_SESSION_TOKEN', defaultValue: '', description: 'AWS_SESSION_TOKEN')

        booleanParam(name: 'FORCE_DELETE', defaultValue: false, description: 'Check this to set force_delete to true')
        booleanParam(name: 'PROCESS_CURRENT_ENV', defaultValue: false, description: 'Check this to process current environment')
        booleanParam(name: 'PROCESS_COMMON_CONFIG', defaultValue: false, description: 'Process common configuration')
    }

    stages {
        stage('Install Node.js Packages') {
            steps {
                sh '''
                cd bankos-dr
                npm install
                '''
            }
        }

        stage('Process Configuration') {
            steps {
                script {
                    env.AWS_ACCESS_KEY_ID = params.AWS_ACCESS_KEY_ID
                    env.AWS_SECRET_ACCESS_KEY = params.AWS_SECRET_ACCESS_KEY
                    env.AWS_SESSION_TOKEN = params.AWS_SESSION_TOKEN

                    // Set environment variables
                    env.SWITCHING_TO = params.SWITCHING_TO

                    def clientsToProcess = []
                    
                    // If custom clients are provided, use those
                    if (params.CUSTOM_CLIENTS?.trim()) {
                        clientsToProcess = params.CUSTOM_CLIENTS.split(',').collect { it.trim() }
                    } 
                    // Otherwise use the dropdown selection
                    else if (params.CLIENT_NAME == 'All') {
                        clientsToProcess = ['ach', 'fedwire', 'fednow', 'rtp', 'sample-client', 'udr']
                    } else {
                        clientsToProcess = [params.CLIENT_NAME]
                    }

                    // Add common config if selected
                    if (params.PROCESS_COMMON_CONFIG) {
                        clientsToProcess.add('common')
                    }
                    
                    // Prepare parallel execution
                    def parallelStages = [:]
                    
                    // Create a parallel stage for each client
                    for (client in clientsToProcess) {
                        // Use local variable to avoid closure issue in parallel stages
                        def currentClient = client
                        
                        parallelStages["Process ${currentClient}"] = {
                            def command = "node bankos-dr/services/rds/main.js"
                            withEnv(["CLIENT_NAME=${currentClient}"]) {
                                if (params.PROCESS_CURRENT_ENV) {
                                    command += ' -pce'
                                }
                                
                                echo "Running for client: ${currentClient}"
                                sh command
                            }
                        }
                    }
                    
                    // Execute all client processing in parallel
                    parallel parallelStages
                }
            }
        }
    }

    post {
        always {
            cleanWs()  // Clean up workspace after the pipeline execution
        }
    }
}